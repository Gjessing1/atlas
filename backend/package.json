{
  "name": "@atlas/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Atlas API server; serves the built web app same-origin in production.",
  "scripts": {
    "_comment:dev": "NODE_EXTRA_CA_CERTS mirrors the Dockerfile: without it kart.miljodirektoratet.no is unreachable from Node (broken upstream chain — see certs/upstream-cas.pem), so overlays that work in dev would 502 and vice versa.",
    "dev": "NODE_EXTRA_CA_CERTS=certs/upstream-cas.pem tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@atlas/conditions": "*",
    "@atlas/core": "*",
    "@atlas/storage": "*",
    "@atlas/sync": "*",
    "@atlas/transit": "*",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.2.0",
    "fflate": "^0.8.2",
    "geotiff": "^3.0.5",
    "pg": "^8.13.0",
    "pmtiles": "^4.4.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2"
  }
}
