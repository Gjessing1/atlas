# --- Personal planning docs (kept local, not committed) ---
# Exception: docs/ROADMAP.md is tracked — its history (planned / shipped / dropped)
# is worth keeping. `docs/*`, not `docs/`: git cannot re-include a file inside an
# ignored directory.
CLAUDE.md
.claude/
docs/*
!docs/ROADMAP.md
AGENTS.md

# --- Dependencies ---
node_modules/
.npm/

# --- Build output ---
dist/
build/
*.tsbuildinfo
# Built web app copied here by backend/Dockerfile for production serving.
backend/public/

# --- Env & secrets ---
.env
.env.*
!.env.example

# --- Persistent data (host: /mnt/data/atlas) ---
data/
# Dev symlink to the host data dir (trailing-slash patterns don't match symlinks).
backend/data
*.sqlite
*.sqlite-shm
*.sqlite-wal

# --- Android app build artifacts ---
# (also in apps/android/.gitignore, but Prettier only reads this root file)
apps/android/android/
apps/android/.gradle-home/
apps/android/.expo/
apps/android/e2e/artifacts/
# Native build intermediates of local expo modules (CMake/ninja).
.cxx/

# --- Logs / misc ---
*.log
npm-debug.log*
.DS_Store
coverage/
.vite/
test-results/
playwright-report/

# Ad-hoc live probes against the real Entur corridor — throwaway scripts that
# import backend/dist and hit the network; findings belong in docs, not here.
backend/.livecheck/
