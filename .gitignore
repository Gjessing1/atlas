apps/android/android/
apps/android/.gradle-home/
apps/android/.expo/
# Native build intermediates of local expo modules (CMake/ninja).
.cxx/

# --- Logs / misc ---
*.log
npm-debug.log*
.DS_Store
coverage/
.vite/
test-results/
playwright-report/
