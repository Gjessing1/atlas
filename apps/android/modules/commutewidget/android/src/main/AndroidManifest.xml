<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- The live commute is the sole launcher widget. Its selector needs no configuration screen. -->
    <receiver
      android:name=".v2.CommuteWidgetV2Provider"
      android:exported="false"
      android:label="@string/atlas_commute_v2_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/atlas_commute_v2_widget_info" />
    </receiver>
  </application>
</manifest>
