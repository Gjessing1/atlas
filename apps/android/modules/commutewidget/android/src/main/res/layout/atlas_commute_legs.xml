<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole leg strip on one line, for an instance with room for one line but
  not for one per vehicle: "280 07:12 → 07:22 · 9 min at Asker stasjon · R14
  07:31 → 07:41", ellipsized where it runs out.

  Its own file rather than a reused `atlas_commute_leg`: there the window is
  wrap_content on purpose (the change is the column that shrinks), and a strip
  painted into a column that cannot shrink would run off the widget instead of
  ending in an ellipsis.
-->
<TextView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/atlas_legs_text"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:ellipsize="end"
  android:maxLines="1"
  android:textColor="@color/atlas_widget_text"
  android:textSize="11sp" />
