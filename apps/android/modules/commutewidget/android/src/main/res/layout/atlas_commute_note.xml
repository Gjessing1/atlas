<?xml version="1.0" encoding="utf-8"?>
<!-- A disruption headline, or the reason a direction has no departures at all. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:baselineAligned="false"
  android:orientation="horizontal"
  android:paddingTop="2dp">
  <ImageView
    android:id="@+id/atlas_note_icon"
    android:layout_width="11dp"
    android:layout_height="11dp"
    android:layout_marginTop="2dp"
    android:contentDescription="@null"
    android:src="@drawable/atlas_widget_alert" />
  <TextView
    android:id="@+id/atlas_note_text"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="2"
    android:textColor="@color/atlas_widget_warn"
    android:textSize="10sp" />
</LinearLayout>
