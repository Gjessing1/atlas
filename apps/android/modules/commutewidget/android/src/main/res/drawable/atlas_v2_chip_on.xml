<?xml version="1.0" encoding="utf-8"?>
<!--
  The live v2 selector chip — the direction the board below it is about.

  Filled, because "which direction am I looking at" must survive a glance from
  arm's length, and an outline that differs only in stroke colour does not. The
  accent tint is the same one the focus uses for its own live numbers, so the
  chip and the answer read as one statement.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@color/atlas_widget_chip" />
  <stroke android:width="1dp" android:color="@color/atlas_widget_accent" />
  <corners android:radius="15dp" />
</shape>
