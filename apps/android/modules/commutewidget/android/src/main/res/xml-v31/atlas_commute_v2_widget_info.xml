<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. The one thing the older descriptor cannot say: `previewLayout`,
  so the picker draws a populated v2 board instead of the empty card a fresh
  instance wears.

  That matters more here than it did for v1, because the two widgets sit next to
  each other in the same picker under near-identical names. The preview pictures
  the mid-journey case — "Change to 🚆 R14 · 07:41" — which is the moment v2
  exists for and the one v1 cannot answer, so the difference is *seen* rather
  than read.

  No `configuration_optional` here, because there is no configuration activity to
  make optional: v2's selector is on the widget.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/atlas_commute_v2_description"
  android:initialLayout="@layout/atlas_commute_v2_widget"
  android:previewLayout="@layout/atlas_commute_v2_widget_preview"
  android:minWidth="250dp"
  android:minHeight="180dp"
  android:minResizeWidth="180dp"
  android:minResizeHeight="150dp"
  android:maxResizeWidth="500dp"
  android:maxResizeHeight="440dp"
  android:resizeMode="horizontal|vertical"
  android:targetCellWidth="4"
  android:targetCellHeight="3"
  android:updatePeriodMillis="0"
  android:widgetCategory="home_screen" />
