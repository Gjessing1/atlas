<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/atlas_commute_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/atlas_commute_widget_background"
  android:gravity="center_vertical"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/atlas_commute_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Commute"
      android:textColor="#FFFFFFFF"
      android:textSize="16sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/atlas_commute_refresh"
      android:layout_width="36dp"
      android:layout_height="32dp"
      android:gravity="center"
      android:text="↻"
      android:textColor="#FFAFC8EA"
      android:textSize="20sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/atlas_commute_route"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF9EABB9"
    android:textSize="11sp" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="OUTBOUND"
    android:textColor="#FF6CA8F7"
    android:textSize="10sp"
    android:textStyle="bold" />
  <TextView
    android:id="@+id/atlas_commute_outbound_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFFFFFFF"
    android:textSize="13sp"
    android:textStyle="bold" />
  <TextView
    android:id="@+id/atlas_commute_outbound_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFD3D9E0"
    android:textSize="12sp" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:text="RETURN"
    android:textColor="#FF6CA8F7"
    android:textSize="10sp"
    android:textStyle="bold" />
  <TextView
    android:id="@+id/atlas_commute_inbound_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFFFFFFF"
    android:textSize="13sp"
    android:textStyle="bold" />
  <TextView
    android:id="@+id/atlas_commute_inbound_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFD3D9E0"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/atlas_commute_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF8996A4"
    android:textSize="10sp" />
</LinearLayout>
