<?xml version="1.0" encoding="utf-8"?>
<!--
  One journey: the commute board's own row, as far as a home screen can carry
  it.

  The first line is the board's scan line: when you leave, when you arrive, the
  correction against the timetable and how long the whole thing takes. The
  scheduled time leads and the correction sits beside it (`atlas_row_delay`),
  because a widget that replaces 08:41 with 08:47 disagrees with the sign at the
  stop, with the app's own commute board, and with the timetable its reader has
  memorised.

  Under it, `atlas_row_legs` is filled by `RemoteViews.addView` with the panel's
  leg strip: one `atlas_commute_leg` per vehicle, each stating its own window and
  the change before it. "280 → R14" alone says a train is involved and nothing
  about when it leaves Asker, which is exactly the question a two-leg commute
  asks. An instance too short for a line per leg gets the same strip on one line;
  a shorter one still gets `atlas_row_lines_inline` — otherwise an invisible
  spacer — carrying the vehicles on line one.

  There is no countdown. It restated the departure time, it was the widest
  column on the line, and it was the one part of a row that went wrong just by
  being looked at a minute later. `atlas_row_status` stands where it did, for
  the one thing a time cannot say about itself — "Cancelled" — and, on an
  instance wide enough to hold it, for the panel's own phrasing of a correction:
  "08:47 est.". The two never collide: a cancelled departure has no delay to
  state, and a delayed one has not been cancelled.

  Colour is set per row from the row's `state`, and per leg from the leg's own —
  the delayed half of a journey should be the half that looks delayed.
-->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/atlas_row_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:focusable="true"
  android:orientation="vertical"
  android:paddingTop="2dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/atlas_row_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="@color/atlas_widget_text"
      android:textSize="14sp"
      android:textStyle="bold" />
    <!--
      Immediately after the time it corrects, and before the arrow.

      It used to sit *after* the arrival, so a delayed journey read
      "08:41 → 09:29 +6" — a correction with two candidate times to belong to,
      and the reader's eye picks the nearer one. Which is the wrong one: the
      arrival is scheduled, and it is the departure that is running late.
    -->
    <TextView
      android:id="@+id/atlas_row_delay"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:maxLines="1"
      android:textColor="@color/atlas_widget_warn"
      android:textSize="11sp"
      android:textStyle="bold" />
    <!--
      The arrow is drawn by the layout, not composed in Kotlin: every string in
      this widget comes from @atlas/transit ready to paint, and "→ " prepended
      here would be the thin end of a second set of labels.
    -->
    <TextView
      android:id="@+id/atlas_row_arrow"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:maxLines="1"
      android:text="@string/atlas_commute_widget_to"
      android:textColor="@color/atlas_widget_muted"
      android:textSize="11sp" />
    <TextView
      android:id="@+id/atlas_row_arrival"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="2dp"
      android:maxLines="1"
      android:textColor="@color/atlas_widget_muted"
      android:textSize="12sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/atlas_row_lines_inline"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/atlas_widget_text"
      android:textSize="12sp" />
    <TextView
      android:id="@+id/atlas_row_duration"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:maxLines="1"
      android:textColor="@color/atlas_widget_muted"
      android:textSize="11sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/atlas_row_status"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:maxLines="1"
      android:textColor="@color/atlas_widget_error"
      android:textSize="11sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/atlas_row_platform"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:maxLines="1"
      android:textColor="@color/atlas_widget_muted"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/atlas_row_legs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" />
</LinearLayout>
