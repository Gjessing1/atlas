<?xml version="1.0" encoding="utf-8"?>
<!--
  One direction's heading inside the v2 body: "TO NATIONALTHEATRET".

  Drawn only when two blocks are on screen — which on v2 means standing at the
  interchange, where either direction is genuinely live (§6.5 §5). With one block
  the selector chip above already names the direction, and repeating it would
  cost a row.
-->
<TextView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/atlas_v2_label"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="4dp"
  android:ellipsize="end"
  android:letterSpacing="0.04"
  android:maxLines="1"
  android:textColor="@color/atlas_widget_accent"
  android:textSize="9sp"
  android:textStyle="bold" />
