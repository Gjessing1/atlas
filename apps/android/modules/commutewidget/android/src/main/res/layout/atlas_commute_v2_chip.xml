<?xml version="1.0" encoding="utf-8"?>
<!--
  One chip of the v2 direction selector: `[ AUTO ]`, `[ TO OSLO ]`, `[ TO HOME ]`.

  Three chips rather than a dropdown, because TRANSIT.md §W1 asks for two things a
  dropdown cannot give at once: the direction has to be obvious at a glance, and
  returning to AUTO has to be **one tap**. A chooser that opens costs two, and a
  cycling button costs up to three.

  The whole chip is the touch target — 30dp tall, which is short for a control
  and correct for one that must not eat the height the rows need. Its background
  is swapped per state by the provider (`setBackgroundResource`), which is the
  only thing about a chip that says which one is live.

  **Weighted, not `wrap_content`.** A place name is whatever the operator called
  it, and "TO NATIONALTHEATRET" beside "TO ENGELSRUD" and AUTO overflows a
  four-cell row and pushes the ↻ off the edge. Sharing the width makes the three
  a segmented control that ellipsizes under pressure instead — and the full
  direction is still spoken, from the chip's contentDescription.
-->
<TextView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/atlas_v2_chip"
  android:layout_width="0dp"
  android:layout_weight="1"
  android:layout_height="30dp"
  android:layout_marginEnd="4dp"
  android:background="@drawable/atlas_v2_chip_off"
  android:ellipsize="end"
  android:gravity="center"
  android:letterSpacing="0.04"
  android:maxLines="1"
  android:paddingStart="9dp"
  android:paddingEnd="9dp"
  android:textColor="@color/atlas_widget_muted"
  android:textSize="10sp"
  android:textStyle="bold" />
