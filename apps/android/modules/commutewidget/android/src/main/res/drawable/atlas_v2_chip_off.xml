<?xml version="1.0" encoding="utf-8"?>
<!--
  A v2 selector chip that is not the live one. An outline rather than a fill:
  three filled chips would compete with the focus line, which is the one thing on
  this widget anyone is actually reading.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@android:color/transparent" />
  <stroke android:width="1dp" android:color="@color/atlas_widget_divider" />
  <corners android:radius="15dp" />
</shape>
