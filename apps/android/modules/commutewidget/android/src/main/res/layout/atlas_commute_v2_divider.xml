<?xml version="1.0" encoding="utf-8"?>
<!--
  A hairline under the v2 focus, separating the answer from the list of
  alternatives.

  A `FrameLayout` rather than the `<View>` this obviously wants to be:
  RemoteViews inflates through a filter that admits only `@RemoteView` classes,
  and `android.view.View` is not one — the failure is an InflateException at
  paint time, which no test in this repo can reach. Same reason every spacer in
  these layouts is a TextView.
-->
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/atlas_v2_divider"
  android:layout_width="match_parent"
  android:layout_height="1dp"
  android:layout_marginTop="4dp"
  android:layout_marginBottom="2dp"
  android:background="@color/atlas_widget_divider" />
