<?xml version="1.0" encoding="utf-8"?>
<!--
  The live commute widget — docs/TRANSIT.md §W1–§W7. Its v2 resource name stays
  stable for existing placements after it becomes the sole registered provider.

  Read top to bottom, it is §W6's information hierarchy in the order the spec
  states it — direction/context, then the current or next action, then the time
  until it, then transfer information, then secondary detail:

   1. `atlas_v2_selector` — the compact direction selector. Three chips filled by
      `addView`, one tap each, so returning to AUTO is one tap and not two. It
      spends about 26dp; the rows below spend what is left.
   2. `atlas_v2_focus_*` — the one thing this widget says loudest. What to do
      next, at display size, with the time it happens at beside it.
   3. `atlas_v2_body` — the journeys, filled by `addView`. Each row is tappable,
      and a tap is the commitment (§W2 tier 1).
   4. `atlas_v2_status` — where the answer came from and how old it is.

  Every string comes from `@atlas/transit` through `POST /api/transit/widget`
  with `variant: "v2"`, part by part. Kotlin chooses columns and colours and owns
  words only about the widget's own state ("Refreshing…", "out of date").
-->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/atlas_v2_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/atlas_commute_widget_background"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <!--
      The selector. Compact is the requirement, not a nicety: its whole job is to
      make the direction obvious while spending almost no height, so it shares a
      line with the ↻ rather than taking one of its own.
    -->
    <LinearLayout
      android:id="@+id/atlas_v2_selector"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="horizontal" />
    <ImageView
      android:id="@+id/atlas_v2_refresh"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/atlas_commute_v2_refresh"
      android:padding="11dp"
      android:src="@drawable/atlas_widget_refresh" />
  </LinearLayout>

  <!--
    The pin's own expiry, and the commitment's. Both are things the widget is
    *doing* on the reader's behalf without being asked again, so both have to be
    visible: a pinned direction that never says when it lets go is wrong for half
    of every day without ever admitting it.
  -->
  <TextView
    android:id="@+id/atlas_v2_pin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/atlas_widget_accent"
    android:textSize="9sp" />

  <LinearLayout
    android:id="@+id/atlas_v2_focus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:orientation="vertical">
    <!-- Axis one and axis two, side by side and never merged (§W6). -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/atlas_v2_focus_phase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:textColor="@color/atlas_widget_accent"
        android:textSize="9sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/atlas_v2_focus_direction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/atlas_widget_muted"
        android:textSize="9sp" />
    </LinearLayout>
    <!--
      The action at display size with its time beside it. The action is the
      weighted column so a long "Change to 🚆 R14" ellipsizes rather than pushing
      the clock time off the edge — the number is the half nobody can guess.
    -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/atlas_v2_focus_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/atlas_widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/atlas_v2_focus_when"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="@color/atlas_widget_text"
        android:textSize="20sp"
        android:textStyle="bold" />
      <!--
        The correction, beside the time it corrects and never on top of it.
        The big number is the *scheduled* one — what the sign at the stop says
        and what the rows below repeat — so a focus reading "23:43" above a row
        reading "23:42 (+1 min)" cannot happen.
      -->
      <TextView
        android:id="@+id/atlas_v2_focus_delay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:maxLines="1"
        android:textColor="@color/atlas_widget_warn"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/atlas_v2_focus_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:maxLines="1"
        android:textColor="@color/atlas_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/atlas_v2_focus_platform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:maxLines="1"
        android:textColor="@color/atlas_widget_accent"
        android:textSize="11sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/atlas_v2_focus_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/atlas_widget_muted"
        android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/atlas_v2_focus_alert_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:orientation="horizontal"
      android:paddingTop="2dp">
      <ImageView
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@null"
        android:src="@drawable/atlas_widget_alert" />
      <TextView
        android:id="@+id/atlas_v2_focus_alert"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/atlas_widget_warn"
        android:textSize="10sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/atlas_v2_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:orientation="vertical" />

  <TextView
    android:id="@+id/atlas_v2_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/atlas_commute_v2_setup_status"
    android:textColor="@color/atlas_widget_muted"
    android:textSize="9sp" />
</LinearLayout>
