{
  "expo": {
    "name": "Atlas",
    "slug": "atlas",
    "scheme": "atlas",
    "version": "0.149.0",
    "runtimeVersion": "11",
    "updates": {
      "url": "https://atlas.gjessing.io/api/app/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "io.gjessing.atlas",
      "versionCode": 23,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "https", "host": "atlas.gjessing.io", "path": "/" }]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2563eb",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/withReleaseSigning.js",
      "./plugins/withAndroidAbis.js",
      "./plugins/withPictureInPicture.js",
      "expo-dev-client",
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Atlas uses your location to guide you turn-by-turn during navigation.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
